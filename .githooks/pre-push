#!/bin/sh
#
# Пошук впровадженого коду перед push.
#
# ЦЕ НАЙСЛАБШИЙ ІЗ ТРЬОХ ШАРІВ — і покладатися на нього не можна.
# Його не буде виконано, якщо:
#   * push зроблено з --no-verify;
#   * push іде з GUI чи бібліотеки, яка хуків не викликає;
#   * клон не виконав одноразового вмикання (див. нижче) — хуки не
#     розповсюджуються разом із репозиторієм, це локальне налаштування;
#   * машина вже заражена, бо код, що дописує навантаження, так само може
#     прибрати цей файл.
# Справжня перевірка — .github/workflows/injected-code-guard.yml, яка виконується
# на CI вже після того, як код пішов на сервер. Цей хук лише економить час:
# ловить помилку до push, коштує мілісекунди.
#
# Вмикання в новому клоні (одноразово):
#   git config core.hooksPath .githooks
#
# Файл без розширення і у вибірку сканування не потрапляє — pathspec у скрипті
# обмежений розширеннями джерел JS-родини.

if [ -x scripts/check-injected-code.sh ] || [ -f scripts/check-injected-code.sh ]; then
  if ! sh scripts/check-injected-code.sh; then
    echo
    echo "Push зупинено. Щоб надіслати попри це: git push --no-verify" >&2
    exit 1
  fi
fi

exit 0
